# systemd *user* unit: mirror the desktop onto the DisplayLink dock.
# Installed to /etc/systemd/user/ and enabled for all users by scripts/install.sh.
# DISPLAY/XAUTHORITY come from the user manager (Plasma exports them).
# -w: wait quietly while no dock monitor is attached, and reattach on replug.
[Unit]
Description=Show the desktop on the DisplayLink dock (dl-mirror: mirror or extended)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# dl-extend runs one dl-mirror per monitor when the login set up an extended
# desktop (see extend/), else a plain "dl-mirror -w".
ExecStart=/usr/local/bin/dl-extend run
# dl-mirror suspends KWin compositing while mirroring; make sure it comes back.
ExecStopPost=-/usr/bin/dbus-send --session --type=method_call --dest=org.kde.KWin /Compositor org.kde.kwin.Compositing.resume
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
